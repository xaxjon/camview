# Never serve data files or generated config — they contain camera
# credentials and password hashes. NOTE: this file only works when the
# vhost allows overrides; install.sh also installs an Apache conf snippet
# (apache.conf) that does not depend on AllowOverride.
<Files ~ "^(streams|users|settings)\.json$|^mediamtx\.yml$">
    Require all denied
</Files>

# Never serve VCS metadata from cloned deployments
RedirectMatch 404 /\.git

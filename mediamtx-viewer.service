[Unit]
Description=Camview streaming gateway (MediaMTX)
After=network-online.target
Wants=network-online.target

[Service]
# __DIR__ is replaced by install.sh with the actual install directory.
ExecStart=__DIR__/bin/mediamtx __DIR__/mediamtx.yml
Restart=always
RestartSec=5
# Optional hardening (hooks must still be able to run bin/ffmpeg):
# User=www-data
# NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
